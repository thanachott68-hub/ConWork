peat);","        const lbl = document.getElementById('cp-start-label');","        if (lbl) lbl.textContent = repeat ? 'เริ่มรอบแรกตั้งแต่วันที่' : 'เริ่มต้น';","        /* nothing picked yet: start from the first date's weekday and day of the month */","        const start = document.getElementById('cp-start-date')?.value;","        if (repeat && start) {","            const pick = (sel, val) => {","                if (document.querySelector(sel + '.is-on')) return;","                const b = document.querySelector(`${sel}[data-d=\"${val}\"]`);","                if (b) { b.classList.add('is-on'); b.setAttribute('aria-pressed', 'true'); }","            };","            pick('.cp-wd', new Date(start + 'T00:00:00').getDay());","            pick('.cp-md', +start.slice(8, 10));","        }","        this._cpRepeatUpdate();","    },","","    _cpChip(btn) {","        btn.classList.toggle('is-on');","        btn.setAttribute('aria-pressed', String(btn.classList.contains('is-on')));","        this._cpRepeatUpdate();","    },","","    /* put a schedule into the form; null means a fixed start/end project */","    _fillCpSchedule(sch) {","        const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = v; };","        const r = sch || {};","        set('cp-rep-every', r.every || 1);","        set('cp-rep-unit', r.unit || 'week');","        set('cp-rep-count', r.count || 12);","        set('cp-rep-until', r.until || '');","        const endRadio = document.getElementById(r.endType === 'date' ? 'cp-rep-end-date' : 'cp-rep-end-count');","        if (endRadio) endRadio.checked = true;","        document.querySelectorAll('.cp-wd').forEach(b => {","            const on = sch ? (r.weekdays || []).map(String).includes(b.dataset.d) : false;","            b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', String(on));","        });","        document.querySelectorAll('.cp-md').forEach(b => {","            const on = sch ? (r.monthDays || []).map(String).includes(b.dataset.d) : false;","            b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', String(on));","        });","        this.setProjectScheduleMode(sch ? 'repeat' : 'range');","    },","","    /* read the repeat settings from the form: null for a fixed-date project, {error} when something is missing */","    _readCpSchedule() {","        if (document.getElementById('cp-schedule-mode')?.value !== 'repeat') return null;","        const start = document.getElementById('cp-start-date')?.value;","        const unit = document.getElementById('cp-rep-unit')?.value || 'week';","        const every = Math.max(1, Math.min(99, parseInt(document.getElementById('cp-rep-every')?.value, 10) || 1));","        const endType = document.querySelector('input[name=\"cp-rep-end\"]:checked')?.value || 'count';","        const count = Math.max(1, Math.min(500, parseInt(document.getElementById('cp-rep-count')?.value, 10) || 0));","        const until = document.getElementById('cp-rep-until')?.value || '';","        const weekdays = [...document.querySelectorAll('.cp-wd.is-on')].map(b => b.dataset.d);","        const monthDays = [...document.querySelectorAll('.cp-md.is-on')].map(b => +b.dataset.d).sort((a, b) => a - b);","        if (!start) return { error: 'กรุณาเลือกวันเริ่มรอบแรก' };","        if (unit === 'week' && !weekdays.length) return { error: 'กรุณาเลือกวันในสัปดาห์ที่ต้องทำซ้ำ' };","        if (unit === 'month' && !monthDays.length) return { error: 'กรุณาเลือกวันที่ของเดือนที่ต้องทำซ้ำ' };","        if (endType === 'count' && !(parseInt(document.getElementById('cp-rep-count')?.value, 10) > 0)) return { error: 'กรุณาใส่จำนวนรอบ' };","        if (endType === 'date' && !until) return { error: 'กรุณาเลือกวันสิ้นสุดการทำซ้ำ' };","        if (endType === 'date' && until < start) return { error: 'วันสิ้นสุดต้องไม่ก่อนวันเริ่มต้น' };","        const sch = { mode: 'repeat', every, unit, weekdays: unit === 'week' ? weekdays : [], monthDays: unit === 'month' ? monthDays : [], endType, count: endType === 'count' ? count : null, until: endType === 'date' ? until : null };","        const all = this._projectOccurrences({ startDate: start, schedule: sch });","        if (!all.length) return { error: 'ไม่มีวันไหนตรงกับรูปแบบที่ตั้งไว้' };","        sch.lastDate = all[all.length - 1];","        return sch;","    },","","    /* every date (YYYY-MM-DD) a repeating project runs on, optionally only those between from and to */","    _projectOccurrences(p, from, to) {","        const sch = p && p.schedule;","        if (!sch || sch.mode !== 'repeat' || !p.startDate) return [];","        const pad = n => String(n).padStart(2, '0');","        const iso = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;","        const start = new Date(p.startDate + 'T00:00:00');","        const every = Math.max(1, sch.every || 1);","        const limitCount = sch.endType === 'count' ? Math.max(1, sch.count || 1) : Infinity;","        const until = sch.endType === 'date' && sch.until ? sch.until : null;","        const hardStop = new Date(start); hardStop.setFullYear(hardStop.getFullYear() + 10);","        const weekdays = (sch.weekdays || []).map(String);","        const monthDays = (sch.monthDays || []).map(Number);","        const startWeek = new Date(start); startWeek.setDate(start.getDate() - start.getDay());","        const out = [];","        let n = 0;","        for (const d = new Date(start); d <= hardStop; d.setDate(d.getDate() + 1)) {","            const ds = iso(d);","            if (until && ds > until) break;","            if (to && ds > to) break;","            let hit = false;","            if (sch.unit === 'day') {","                hit = Math.round((d - start) / 86400000) % every === 0;","            } else if (sch.unit === 'week') {","                const weeks = Math.floor(Math.round((d - startWeek) / 86400000) / 7);","                hit = weeks % every === 0 && weekdays.includes(String(d.getDay()));","            } else {","                const months = (d.getFullYear() - start.getFullYear()) * 12 + d.getMonth() - start.getMonth();","                const last = new Date(d.getFullYear(), d.getMonth() + 1, 0).getDate();","                const day = d.getDate();","                hit = months % every === 0 && (monthDays.includes(day) || (day === last && monthDays.some(m => m > last)));","            }","            if (!hit) continue;","            n++;","            if (!from || ds >= from) out.push(ds);","            if (n >= limitCount) break;","        }","        return out;","    },","","    /* show or hide the weekday / day-of-month pickers and write the summary line under the repeat settings */","    _cpRepeatUpdate() {","        const unit = document.getElementById('cp-rep-unit')?.value || 'week';","        document.getElementById('cp-rep-week-row')?.classList.toggle('hidden', unit !== 'week');","        document.getElementById('cp-rep-month-row')?.classList.toggle('hidden', unit !== 'month');","        const endType = document.querySelector('input[name=\"cp-rep-end\"]:checked')?.value || 'count';","        const cnt = document.getElementById('cp-rep-count'), until = document.getElementById('cp-rep-until');","        if (cnt) cnt.disabled = endType !== 'count';","        if (until) until.disabled = endType !== 'date';","        const box = document.getElementById('cp-rep-summary');","        if (!box || document.getElementById('cp-schedule-mode')?.value !== 'repeat') return;","        const en = typeof i18nIsEnglish === 'function' && i18nIsEnglish();","        const start = document.getElementById('cp-start-date')?.value;","        const sch = this._readCpSchedule();","        if (!start || !sch || sch.error) {","            box.className = 'cp-rep-summary is-empty';","            box.textContent = en ? 'Pick a first date and the days to repeat on to see the rounds.' : 'เลือกวันเริ่มและวันที่ต้องทำซ้ำ แล้วจะเห็นรอบทั้งหมดตรงนี้';","            return;","        }","        const all = this._projectOccurrences({ startDate: start, schedule: sch });","        const fmt = ds => new Date(ds + 'T00:00:00').toLocaleDateString(en ? 'en-GB' : 'th-TH', { day: 'numeric', month: 'short', year: 'numeric' });","        const unitTxt = en ? { day: 'day', week: 'week', month: 'month' }[sch.unit] + (sch.every > 1 ? 's' : '') : { day: 'วัน', week: 'สัปดาห์', month: 'เดือน' }[sch.unit];","        const dayNames = en ? ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'] : ['อา.', 'จ.', 'อ.', 'พ.', 'พฤ.', 'ศ.', 'ส.'];","        let rule = en ? `Every ${sch.every > 1 ? sch.every + ' ' : ''}${unitTxt}` : `ทุก ${sch.every > 1 ? sch.every + ' ' : ''}${unitTxt}`;","        if (sch.unit === 'week') rule += (en ? ' on ' : ' วัน ') + ['1', '2', '3', '4', '5', '6', '0'].filter(d => sch.weekdays.includes(d)).map(d => dayNames[+d]).join(', ');","        if (sch.unit === 'month') rule += (en ? ' on day ' : ' วันที่ ') + sch.monthDays.join(', ');","        const preview = all.slice(0, 4).map(fmt).join(' · ') + (all.length > 4 ? ' …' : '');","        box.className = 'cp-rep-summary';","        box.innerHTML = `<b>${rule}</b><span>${en ? `${all.length} rounds · ${fmt(all[0])} to ${fmt(all[all.length - 1])}` : `${all.length} รอบ · ${fmt(all[0])} ถึง ${fmt(all[all.length - 1])}`}</span><span class=\"cp-rep-dates\">${preview}</span>`;","    },","","    /* repeat settings also live in this browser, so they survive when the projects table has no schedule column yet */","    _saveProjectSchedule(id, sch) {","        try {","            const map = JSON.parse(localStorage.getItem('conwork_project_schedules') || '{}');","            if (sch) map[id] = sch; else delete map[id];","            localStorage.setItem('conwork_project_schedules', JSON.stringify(map));","        } catch (e) { }","    },","    _loadProjectSchedule(id, fromDb) {","        if (fromDb && typeof fromDb === 'object' && fromDb.mode === 'repeat') return fromDb;","        try {","            const map = JSON.parse(localStorage.getItem('conwork_project_schedules') || '{}');","            return map[id] || null;","        } catch (e) { return null; }","    },",""]],[5736,[[40,41,"6"]]],[5739,[[62,63,"6"]]],[5816,5817,["        const schedule = this._readCpSchedule();","        if (schedule && schedule.error) { App._showToast(schedule.error, 'error'); return; }","        /* a repeating project ends on its last round, so lists, status and the database keep working with one end date */","        const endDate = schedule ? schedule.lastDate : document.getElementById('cp-end-date')?.value;"]],[5819,5819,["        if (schedule) delete schedule.lastDate;"]],[5861,5862,["                proj.schedule = schedule;","                this._saveProjectSchedule(proj.id, schedule);"]],[5866,[[159,159,", schedule: schedule"]]],[5950,5951,["                        departments: teams,","                        schedule: schedule"]],[6019,[[26,27,"sched"],[29,30,"e"]]],[6023,6023,["            this._saveProjectSchedule(newProject.id, schedule);"]]]}
