{"path":"css\\skylearn.css","new":"23503226A1C24C04A47CFF06F7B571778FEC126FAA2335EC5B3366989A5E4290","orig":"","create":["/* ============================================================","   ConWork × Skylearn design system","   Sky blue for action, sun yellow for achievements, leaf green for progress,","   gentle coral for problems. Loaded last on every page.","   ============================================================ */","",":root {","    --sky: #3B82F6;","    --sky-bright: #60A5FA;","    --sky-deep: #1D4ED8;","    --sky-soft: #DBEAFE;","    --sun: #FBBF24;","    --sun-bright: #FCD34D;","    --sun-deep: #D97706;","    --leaf: #22C55E;","    --leaf-soft: #DCFCE7;","    --leaf-deep: #16A34A;","    --coral: #F87171;","    --coral-soft: #FEE2E2;","    --berry: #A855F7;","","    --bg: #FFFFFF;","    --surface: #F8FAFC;","    --surface-elevated: #FFFFFF;","    --surface-sunken: #F1F5F9;","    --ink: #0F172A;","    --ink-muted: #475569;","    --ink-subtle: #94A3B8;","    --ink-faint: #CBD5E1;","    --outline: #E2E8F0;","    --outline-strong: #94A3B8;","","    --font-display: 'Nunito', 'Kanit', sans-serif;","    --font-body: 'Atkinson Hyperlegible Next', 'Atkinson Hyperlegible', 'IBM Plex Sans Thai', 'Nunito Sans', sans-serif;","    --font-mono: 'JetBrains Mono', monospace;","","    --r-input: 12px;","    --r-button: 16px;","    --r-card: 20px;","    --r-modal: 28px;","","    --shadow-card-hover: 0 8px 24px rgba(15, 23, 42, 0.06);","    --shadow-active: 0 12px 32px rgba(59, 130, 246, 0.15);","    --shadow-modal: 0 24px 48px rgba(15, 23, 42, 0.12);","    --shadow-reward: 0 0 24px rgba(252, 211, 77, 0.4);","","    --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);","    --dur: 240ms;","    --focus-ring: 0 0 0 4px rgba(59, 130, 246, 0.25);","}","","html.dark {","    --bg: #0F172A;","    --surface: #172033;","    --surface-elevated: #1E293B;","    --surface-sunken: #0B1120;","    --ink: #F1F5F9;","    --ink-muted: #CBD5E1;","    --ink-subtle: #94A3B8;","    --ink-faint: #475569;","    --outline: #334155;","    --outline-strong: #64748B;","    --shadow-card-hover: 0 8px 24px rgba(0, 0, 0, 0.3);","    --shadow-modal: 0 24px 48px rgba(0, 0, 0, 0.45);","    --focus-ring: 0 0 0 4px rgba(96, 165, 250, 0.35);","}","","/* ---------- Type ---------- */","body {","    font-family: var(--font-body);","    letter-spacing: 0.01em;","    color: var(--ink);","    -webkit-font-smoothing: antialiased;","}","","h1, h2, h3,",".font-display {","    font-family: var(--font-display);","    letter-spacing: -0.01em;","}","","code, kbd, pre, .font-mono {","    font-family: var(--font-mono);","}","","/* Tiny hard-coded sizes are lifted so nothing reads smaller than a caption */",".text-\\[9px\\] { font-size: 12px !important; }",".text-\\[10px\\] { font-size: 12px !important; line-height: 16px; }",".text-\\[11px\\] { font-size: 13px !important; line-height: 18px; }","","/* Numbers line up in stat cards, tables and timers */",".tabular-nums, td, [id^=\"stat-\"] {","    font-variant-numeric: tabular-nums;","}","","/* ---------- Page surfaces ---------- */","body.bg-cream,",".bg-cream {","    background-color: var(--surface) !important;","}","","main > header {","    background-color: rgba(255, 255, 255, 0.85) !important;","    backdrop-filter: blur(12px);","    -webkit-backdrop-filter: blur(12px);","    border-bottom: 1px solid var(--outline) !important;","}","","/* ---------- Sidebar ---------- */","#app-sidebar {","    background-color: #FFFFFF !important;","    border-right: 1px solid var(--outline) !important;","    box-shadow: none !important;","}","","#app-sidebar h2 {","    font-family: var(--font-display);","    color: var(--ink) !important;","}","","#app-sidebar .nav-item,","#app-sidebar .subnav-item {","    border-radius: var(--r-button) !important;","    min-height: 48px;","    font-weight: 600;","    color: var(--ink-muted) !important;","    transition: background-color var(--dur) ease, color var(--dur) ease, transform var(--dur) var(--ease-bounce);","}","","#app-sidebar .nav-item i,","#app-sidebar .subnav-item i {","    color: var(--ink-subtle) !important;","    transition: color var(--dur) ease;","}","","#app-sidebar .nav-item:hover,","#app-sidebar .subnav-item:hover {","    background-color: var(--surface-sunken) !important;","    color: var(--ink) !important;","}","","#app-sidebar .nav-item:hover i,","#app-sidebar .subnav-item:hover i {","    color: var(--sky) !important;","}","","/* Current page: sky-soft pill with a deep-sky label, the way Skylearn marks the active lesson */","#app-sidebar .nav-item.bg-blue-600,","#app-sidebar .subnav-item.bg-blue-600 {","    background-color: var(--sky-soft) !important;","    color: var(--sky-deep) !important;","    box-shadow: inset 4px 0 0 var(--sky);","}","","#app-sidebar .nav-item.bg-blue-600 i,","#app-sidebar .subnav-item.bg-blue-600 i {","    color: var(--sky-deep) !important;","}","","#sidebar-profile-section {","    background-color: var(--surface) !important;","    border-top: 1px solid var(--outline) !important;","}","","#sidebar-profile-section:hover {","    background-color: var(--surface-sunken) !important;","}","","#current-user-name { color: var(--ink) !important; }","#current-user-dept { color: var(--ink-muted) !important; }","","/* ---------- Buttons ---------- */",".bg-blue-600 {","    background-color: #2563EB !important;","}","",".hover\\:bg-blue-700:hover,",".hover\\:bg-blue-500:hover,",".bg-blue-600.hover\\:bg-blue-700:hover {","    background-color: var(--sky-deep) !important;","}","","button,","[role=\"button\"],","a.inline-flex {","    transition: background-color var(--dur) ease, border-color var(--dur) ease, color var(--dur) ease,","        box-shadow var(--dur) ease, transform var(--dur) var(--ease-bounce);","}","","/* Primary actions: friendly 16px corners, firm label, a small lift on hover */","button.bg-blue-600,","button.bg-blue-500,","button.bg-primary,","a.bg-blue-600:not(.nav-item):not(.subnav-item) {","    border-radius: var(--r-button);","    font-weight: 700;","    min-height: 44px;","}","","button.bg-blue-600:hover,","button.bg-blue-500:hover,","button.bg-primary:hover {","    transform: translateY(-1px);","    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);","}","","button.bg-blue-600:active,","button.bg-blue-500:active,","button.bg-primary:active {","    transform: translateY(0) scale(0.98);","    box-shadow: none;","}","","button.rounded-lg,","a.rounded-lg.inline-flex {","    border-radius: var(--r-input);","}","","button:disabled,","button[disabled] {","    cursor: not-allowed;","    opacity: 0.55;","    transform: none !important;","    box-shadow: none !important;","}","","/* ---------- Focus (keyboard) ---------- */",":focus-visible {","    outline: 3px solid var(--sky) !important;","    outline-offset: 2px;","}","","/* ---------- Inputs ---------- */","input[type=\"text\"],","input[type=\"email\"],","input[type=\"password\"],","input[type=\"search\"],","input[type=\"number\"],","input[type=\"tel\"],","input[type=\"url\"],","input[type=\"date\"],","input[type=\"time\"],","input[type=\"datetime-local\"],","select,","textarea {","    transition: border-color var(--dur) ease, box-shadow var(--dur) ease, background-color var(--dur) ease;","}","","input[type=\"text\"]:not(.bg-transparent):not(.border-0):not(.border-none),","input[type=\"email\"]:not(.bg-transparent):not(.border-0):not(.border-none),","input[type=\"password\"]:not(.bg-transparent):not(.border-0):not(.border-none),","input[type=\"search\"]:not(.bg-transparent):not(.border-0):not(.border-none),","input[type=\"number\"]:not(.bg-transparent):not(.border-0):not(.border-none),","input[type=\"tel\"]:not(.bg-transparent):not(.border-0):not(.border-none),","input[type=\"date\"]:not(.bg-transparent):not(.border-0):not(.border-none),","textarea:not(.bg-transparent):not(.border-0):not(.border-none),","select:not(.bg-transparent):not(.border-0):not(.border-none) {","    border-color: var(--outline);","}","","input:focus,","select:focus,","textarea:focus {","    border-color: var(--sky) !important;","    box-shadow: var(--focus-ring) !important;","    outline: none !important;","}","","input:focus-visible,","select:focus-visible,","textarea:focus-visible {","    outline: none !important;","}","","input.rounded-lg,","select.rounded-lg,","textarea.rounded-lg {","    border-radius: var(--r-input);","}","","input[type=\"checkbox\"],","input[type=\"radio\"] {","    accent-color: var(--sky);","}","","::placeholder {","    color: var(--ink-subtle);","    opacity: 1;","}","","/* ---------- Cards ---------- */",".bg-white.rounded-xl,",".bg-white.rounded-2xl,",".bg-white.rounded-3xl {","    border-color: var(--outline);","}","",".bg-white.rounded-2xl.shadow-sm,",".bg-white.rounded-xl.shadow-sm,",".bg-white.rounded-2xl.border,",".bg-white.rounded-xl.border {","    transition: box-shadow var(--dur) ease, transform var(--dur) var(--ease-bounce), border-color var(--dur) ease;","}","",".bg-white.rounded-2xl.shadow-sm:not(.no-hover):hover,",".bg-white.rounded-xl.shadow-sm.cursor-pointer:hover,",".bg-white.rounded-2xl.cursor-pointer:hover {","    box-shadow: var(--shadow-card-hover) !important;","}","",".cursor-pointer.bg-white.rounded-2xl:hover,",".cursor-pointer.bg-white.rounded-xl:hover {","    transform: translateY(-2px);","}","","/* ---------- Progress, chips, badges ---------- */",".rounded-full.overflow-hidden > .rounded-full,","[role=\"progressbar\"] > * {","    transition: width 480ms ease-out;","}","","/* Sun yellow is for wins: give earned/complete badges the reward glow */",".badge-earned,",".reward-badge {","    background-color: var(--sun);","    box-shadow: var(--shadow-reward);","    animation: sky-pop 480ms var(--ease-bounce) both;","}","","@keyframes sky-pop {","    from { transform: scale(0.6); opacity: 0; }","    to { transform: scale(1); opacity: 1; }","}","","/* ---------- Modals ---------- */","div[id$=\"-modal\"] > div.bg-white,","div[id$=\"-modal\"] > div > div.bg-white.rounded-2xl,","div[id$=\"-modal\"] > div.rounded-2xl {","    border-radius: var(--r-modal) !important;","    box-shadow: var(--shadow-modal) !important;","}","",".backdrop-blur-sm {","    -webkit-backdrop-filter: blur(6px);","    backdrop-filter: blur(6px);","}","","/* ---------- Tables ---------- */","table th {","    font-weight: 700;","    color: var(--ink-muted);","}","","/* ---------- Chat area ---------- */",".bg-\\[\\#f8fafc\\] {","    background-color: var(--surface-sunken) !important;","}","","/* ---------- Sign in / sign up ---------- */","#btn-auth-continue {","    min-height: 56px;","    border-radius: var(--r-button) !important;","    font-size: 18px;","    font-weight: 700;","    background-color: #2563EB !important;","}","","#btn-auth-continue:hover {","    background-color: var(--sky-deep) !important;","}","","#auth-title {","    font-family: var(--font-display);","    letter-spacing: -0.015em;","}","","/* ---------- Landing page ---------- */","#landing-screen {","    font-family: var(--font-body);","}","","#landing-screen h1,","#landing-screen h2,","#landing-screen h3 {","    font-family: var(--font-display) !important;","}","","#cw-hero1 .cta,",".cwx-j2 .cta {","    border-radius: var(--r-button) !important;","    min-height: 56px;","    background: #2563EB !important;","}","","#cw-hero1 .cta:hover,",".cwx-j2 .cta:hover {","    background: var(--sky-deep) !important;","}","","#cw-hero1 .card,",".cwx-j2 .card {","    border-radius: var(--r-card) !important;","    border: 1px solid var(--outline) !important;","}","","#cw-hero1 .navcta,",".cwx-j2 .signin {","    border-radius: var(--r-button) !important;","    background: var(--ink) !important;","}","","/* ============================================================","   Dark mode: slate night instead of navy, same sky accents","   ============================================================ */","html.dark body {","    background-color: var(--bg) !important;","    color: var(--ink) !important;","}","","html.dark main {","    background-color: var(--bg) !important;","}","","html.dark body.bg-cream,","html.dark .bg-cream {","    background-color: var(--bg) !important;","}","","html.dark main > header {","    background-color: rgba(11, 17, 32, 0.85) !important;","    border-color: var(--outline) !important;","    box-shadow: none !important;","}","","html.dark #app-sidebar {","    background-color: var(--surface-sunken) !important;","    border-right-color: var(--outline) !important;","    box-shadow: none !important;","}","","html.dark #app-sidebar h2 { color: var(--ink) !important; }","","html.dark #app-sidebar .nav-item,","html.dark #app-sidebar .subnav-item {","    color: var(--ink-muted) !important;","}","","html.dark #app-sidebar .nav-item:hover,","html.dark #app-sidebar .subnav-item:hover {","    background-color: #1E293B !important;","    color: var(--ink) !important;","}","","html.dark #app-sidebar .nav-item.bg-blue-600,","html.dark #app-sidebar .subnav-item.bg-blue-600 {","    background-color: rgba(59, 130, 246, 0.18) !important;","    color: #BFDBFE !important;","    box-shadow: inset 4px 0 0 var(--sky-bright);","}","","html.dark #app-sidebar .nav-item.bg-blue-600 i,","html.dark #app-sidebar .subnav-item.bg-blue-600 i {","    color: #BFDBFE !important;","}","","html.dark #sidebar-profile-section {","    background-color: var(--surface-sunken) !important;","    border-top-color: var(--outline) !important;","}","","html.dark #sidebar-profile-section:hover {","    background-color: #1E293B !important;","}","","html.dark .bg-white {","    background-color: var(--surface-elevated) !important;","}","","html.dark .bg-white.rounded-xl,","html.dark .bg-white.rounded-2xl,","html.dark .bg-white.rounded-3xl {","    border-color: var(--outline) !important;","}","","html.dark .bg-blue-600,","html.dark div[id$=\"-modal\"] button.bg-blue-600 {","    background-color: #2563EB !important;","}","","html.dark .hover\\:bg-blue-700:hover,","html.dark .hover\\:bg-blue-500:hover,","html.dark div[id$=\"-modal\"] button.bg-blue-600:hover {","    background-color: var(--sky) !important;","}","","html.dark input:not(.bg-transparent),","html.dark textarea:not(.bg-transparent),","html.dark select:not(.bg-transparent) {","    border-color: var(--outline) !important;","}","","/* ---------- Reduced motion ---------- */","@media (prefers-reduced-motion: reduce) {","    *,","    *::before,","    *::after {","        transition-duration: 120ms !important;","        animation-duration: 120ms !important;","        animation-iteration-count: 1 !important;","    }","","    button:hover,","    .cursor-pointer:hover {","        transform: none !important;","    }","}","","/* Big numbers use the display face (its zero has no slash) */","[id^=\"stat-\"],",".text-3xl.font-bold,",".text-4xl.font-bold {","    font-family: var(--font-display);","    font-variant-numeric: tabular-nums;","}","","#cw-hero1 h1 .ha,",".cwx-j2 h1 .ha {","    white-space: nowrap;","}","","#landing-screen h1 {","    font-weight: 800 !important;","}","","/* Landing in dark mode: keep the subtitle readable and the highlighted words bright */","html.dark #cw-hero1 .sub,","html.dark .cwx-j2 .sub {","    color: #CBD5E1 !important;","}","","html.dark #cw-hero1 .ha,","html.dark .cwx-j2 .ha {","    --c1: #60A5FA !important;","    --c2: #93C5FD !important;","    --cw-c1: #60A5FA !important;","    --cw-c2: #93C5FD !important;","}",""]}
